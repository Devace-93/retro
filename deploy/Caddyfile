# retro reverse proxy (local development). Single host on :8082; the production
# routing lives in the 3m4 edge Caddy (see PRODUCTION.md), with the same rules.

:8082 {
	# --- API ---
	handle /api/* {
		reverse_proxy api:5000
	}

	# --- MCP (Streamable HTTP) for AI agents ---
	handle /mcp* {
		reverse_proxy mcp:3333
	}

	# --- Widget bundle: a static file served by the web service, embedded by
	# third-party sites, so it must be cacheable and CORS-open.
	@widget path /widget.js /widget/*
	handle @widget {
		header Cache-Control "public, max-age=300"
		header Access-Control-Allow-Origin "*"
		reverse_proxy web:3000
	}

	# --- Marketing + dashboard + public boards (Qwik SSR) --- everything else.
	handle {
		reverse_proxy web:3000
	}
}
